# Buzzora — environment configuration
# Copy to .env.local and fill in real values. Never commit real keys.

# Canonical site URL (used for metadata / schema)
NEXT_PUBLIC_SITE_URL=https://www.buzzora.co.in

# Supabase PostgreSQL Database & Admin Authentication Configuration
# Powers database queries, customer anti-IDOR verification, and Admin Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Master cryptographic signing secret for customer order verification tokens (anti-IDOR)
# SERVER_ONLY — REQUIRED IN PRODUCTION (no fallback, fails closed if missing in production)
ORDER_VERIFICATION_SECRET=

# Distributed Rate Limiting (Upstash Redis REST API)
# Powers serverless rate limiting on Vercel across distributed lambdas.
# When omitted, falls back automatically to local in-memory sliding window for development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WhatsApp business number in international format, digits only (e.g. 91XXXXXXXXXX).
# Turns on the floating "Chat with us" button AND the WhatsApp checkout, which
# sends each order straight to this number. Works on static hosting (no server).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Business contact email — used by the wholesale form and as an order fallback.
NEXT_PUBLIC_CONTACT_EMAIL=buzzora.dev@gmail.com

# Turn on server-verified online card/UPI payments (needs a server host like
# Vercel — not GitHub Pages). Set to "razorpay" or "phonepe".
NEXT_PUBLIC_PAYMENT_PROVIDER=
PAYMENT_PROVIDER=

# PhonePe Standard Checkout V2 (set PHONEPE_ENV=production only after UAT passes).
PHONEPE_ENV=sandbox
PHONEPE_MOCK_MODE=false # Set to "true" ONLY during local development testing (disabled in production)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_AUTH_URL=
PHONEPE_API_BASE_URL=
PHONEPE_WEBHOOK_SECRET=
PHONEPE_WEBHOOK_KEY_ID=

# Razorpay (if payments enabled). Get keys at dashboard.razorpay.com.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (if PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Analytics (optional — only loaded when set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=


# Resend Transactional Email Configuration (SERVER-ONLY)
# Powers customer transactional emails: ORDER_CONFIRMED, ORDER_SHIPPED, ORDER_DELIVERED
# Never expose to the client. Set in Vercel project environment variables.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Buzzora <orders@buzzora.co.in>"
RESEND_REPLY_TO=buzzora.dev@gmail.com
RESEND_WEBHOOK_SECRET=
